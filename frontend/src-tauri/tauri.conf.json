{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Halvern",
  "version": "0.1.1",
  "identifier": "io.halvern.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Halvern",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "connect-src": "'self' http://localhost:11434 http://localhost:5167"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main window capability with file system and media access",
          "windows": [
            "main"
          ],
          "permissions": [
            "fs:default",
            "fs:allow-read-file",
            "fs:read-all",
            "fs:write-all",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-download-write",
            "fs:allow-download-read",
            "fs:scope-download",
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "store:default",
            "notification:default",
            "notification:allow-is-permission-granted",
            "process:default",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/*"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/app_icon.icns",
      "icons/app_icon.ico"
    ],
    "resources": [
      "templates/*.json"
    ],
    "externalBin": [
      "binaries/llama-helper",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.4"
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hretheum/halvern/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQUEwRTM5NzY5ODUxOApSV1FZaFdtWDQ2RDZDelhKVEVHbkxQcjFJaXMwbDFZdFhZenB1QXh4bkdibFkreG5lLzRYZXZ4Ywo="
    }
  }
}
